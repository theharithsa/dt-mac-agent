#!/bin/bash
# dtmacctl: control and inspect dt-mac-agent.
set -u

_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _t="$(readlink "$_src")"
  case "$_t" in /*) _src="$_t" ;; *) _src="$(dirname "$_src")/$_t" ;; esac
done
DTMA_HOME="${DTMA_HOME:-$(cd "$(dirname "$_src")/.." && pwd)}"
# shellcheck source=/dev/null
. "$DTMA_HOME/lib/common.sh"

usage() {
  cat <<EOF
dtmacctl $DTMA_VERSION - control dt-mac-agent

Usage: sudo dtmacctl <command>

  status        show agent, watchdog, heartbeat and last ingest result
  start         enable and start agent + watchdog
  stop          stop agent + watchdog (stays stopped across reboots)
  restart       restart the agent
  logs [name] [-f]
                show (or follow) logs; name = agent | ingest | watchdog | install (default: all)
  payload       show the last metric batch sent to Dynatrace
  metrics       list all metrics with unit and description
  test          collect once and print the metric lines (nothing is sent)
  send-test     send a single test metric to Dynatrace
  update [--check]
                install the latest GitHub release now (--check: only report)
  dashboard     upload/refresh the 'MacOS Health Center' dashboard (needs a platform token)
  config        show the configuration (token masked)
  version       print version
  uninstall [--keep-config]
                remove dt-mac-agent from this Mac
EOF
}

need_root() {
  [ "$(id -u)" -eq 0 ] || { echo "dtmacctl: '$1' requires root (use sudo)" >&2; exit 1; }
}

job_line() {
  local label="$1" name="$2"
  if job_loaded "$label"; then
    printf '  %-10s: loaded, state=%s, pid=%s, last exit=%s\n' "$name" \
      "$(job_field "$label" state)" "$(job_field "$label" pid)" "$(job_field "$label" 'last exit code')"
  else
    printf '  %-10s: not loaded\n' "$name"
  fi
}

cmd_status() {
  local hb last
  load_config
  echo "dt-mac-agent $DTMA_VERSION"
  job_line "$DTMA_LABEL" agent
  job_line "$DTMA_WD_LABEL" watchdog
  if [ -r "$DTMA_STATE_DIR/heartbeat" ]; then
    hb="$(cat "$DTMA_STATE_DIR/heartbeat")"
    printf '  %-10s: %ss ago\n' heartbeat "$(($(date +%s) - hb))"
    if [ -r "$DTMA_STATE_DIR/last_status" ]; then
      last="$(cat "$DTMA_STATE_DIR/last_status")"
      printf '  %-10s: %s (%s lines, %s)\n' "last send" "$(date -r "${last%% *}" '+%Y-%m-%d %H:%M:%S')" \
        "$(echo "$last" | awk '{print $2}')" "$(echo "$last" | cut -d' ' -f3-)"
    fi
    SPOOL_DIR="$DTMA_STATE_DIR/spool"
    printf '  %-10s: %s buffered batches\n' spool "$(spool_count)"
    printf '  %-10s: %s\n' restarts "$(read_count watchdog_restarts) (by watchdog)"
    if [ "$SEND_LOGS" = "1" ]; then
      printf '  %-10s: enabled, last result %s\n' "log ship" "$(cat "$DTMA_STATE_DIR/logship.status" 2>/dev/null || echo pending)"
    else
      printf '  %-10s: disabled\n' "log ship"
    fi
    if [ -r "$DTMA_STATE_DIR/update.checked" ]; then
      printf '  %-10s: %s, last check %s\n' "auto-upd." "$([ "$AUTO_UPDATE" = 1 ] && echo enabled || echo disabled)" \
        "$(date -r "$(cat "$DTMA_STATE_DIR/update.checked")" '+%Y-%m-%d %H:%M')"
    fi
  else
    echo "  (run with sudo for heartbeat and ingest details)"
  fi
  [ -f "$DTMA_STATE_DIR/stopped" ] && echo "  NOTE: agent was stopped with 'dtmacctl stop'"
  if resolve_ingest 2>/dev/null; then printf '  %-10s: %s\n' endpoint "$INGEST_URL"; fi
  printf '  %-10s: %s\n' home "$DTMA_HOME"
  printf '  %-10s: %s\n' logs "$DTMA_LOG_DIR"
}

cmd_dashboard() {
  local file="$DTMA_HOME/dashboards/macos-health-center.json" token="${DTMA_DASHBOARD_TOKEN:-}"
  need_root dashboard
  load_config
  [ -f "$file" ] || { echo "dashboard file not found: $file" >&2; exit 1; }
  case "$DT_TOKEN" in dt0s16.*) token="${token:-$DT_TOKEN}" ;; esac
  if [ -z "$token" ]; then
    # Classic API tokens cannot use the Document API; the platform token is used once and not stored.
    if (exec </dev/tty) 2>/dev/null; then
      printf 'Platform token (dt0s16.) with document:documents:write, used once and not stored (input hidden): ' >/dev/tty
      read -r -s token </dev/tty || true
      printf '\n' >/dev/tty
    fi
  fi
  case "$token" in
    dt0s16.*) ;;
    *) echo "a platform token (dt0s16.*) with document:documents:write is required; pass it via DTMA_DASHBOARD_TOKEN or the prompt" >&2; exit 1 ;;
  esac
  WORK_DIR="$(mktemp -d /tmp/dt-mac-agent-dash.XXXXXX)"
  if upload_dashboard "$file" "$token"; then
    echo "Dashboard '$DTMA_DASHBOARD_NAME' $DASHBOARD_ACTION: $DASHBOARD_URL"
    rm -rf "$WORK_DIR"
  else
    echo "Dashboard upload failed (HTTP $HTTP_CODE): $HTTP_DETAIL" >&2
    rm -rf "$WORK_DIR"
    exit 1
  fi
}

cmd_update() {
  local latest
  need_root update
  latest="$(latest_version)"
  [ -n "$latest" ] || { echo "could not reach GitHub" >&2; exit 1; }
  if ! version_gt "$latest" "$DTMA_VERSION"; then
    echo "up to date ($DTMA_VERSION)"
    return 0
  fi
  echo "new release available: $latest (installed $DTMA_VERSION)"
  [ "${1:-}" = "--check" ] && return 0
  run_update "$latest" verbose
}

cmd_start() {
  local l
  need_root start
  rm -f "$DTMA_STATE_DIR/stopped"
  for l in "$DTMA_LABEL" "$DTMA_WD_LABEL"; do
    launchctl enable "system/$l"
    job_loaded "$l" || launchctl bootstrap system "$DTMA_PLIST_DIR/$l.plist"
  done
  echo "started"
}

cmd_stop() {
  local l
  need_root stop
  mkdir -p "$DTMA_STATE_DIR" && touch "$DTMA_STATE_DIR/stopped"
  for l in "$DTMA_LABEL" "$DTMA_WD_LABEL"; do
    launchctl disable "system/$l"
    launchctl bootout "system/$l" 2>/dev/null || true
  done
  echo "stopped (run 'sudo dtmacctl start' to resume)"
}

cmd_send_test() {
  local f rc
  load_config
  [ -r "$DTMA_CONFIG" ] || { echo "cannot read $DTMA_CONFIG (use sudo)" >&2; exit 1; }
  resolve_ingest || exit 1
  host_info
  DTMA_STATE_DIR="$(mktemp -d /tmp/dt-mac-agent-test.XXXXXX)"
  init_dirs
  f="$WORK_DIR/test.txt"
  printf '%s.agent.test,host.name="%s",agent.version="%s" gauge,1\n' "$METRIC_PREFIX" "$HOST_NAME" "$DTMA_VERSION" >"$f"
  send_file "$f"
  rc=$?
  rm -rf "$DTMA_STATE_DIR"
  if [ "$rc" -eq 0 ] && [ "$LAST_STATUS" != "partial 400" ]; then
    echo "OK: Dynatrace accepted the test metric ($LAST_STATUS) at $INGEST_URL"
  else
    echo "FAILED: $LAST_STATUS from $INGEST_URL" >&2
    exit 1
  fi
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift
case "$cmd" in
  status) cmd_status ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart)
    need_root restart
    launchctl kickstart -k "system/$DTMA_LABEL" && echo "restarted"
    ;;
  logs)
    files=""
    follow=""
    for a in "$@"; do
      case "$a" in
        -f) follow="-f" ;;
        agent|ingest|watchdog|install) files="$files $DTMA_LOG_DIR/$a.log" ;;
        *) echo "unknown log '$a' (agent | ingest | watchdog | install)" >&2; exit 2 ;;
      esac
    done
    [ -n "$files" ] || files="$DTMA_LOG_DIR/install.log $DTMA_LOG_DIR/watchdog.log $DTMA_LOG_DIR/agent.log $DTMA_LOG_DIR/ingest.log"
    # shellcheck disable=SC2086
    tail -n 50 $follow $files 2>/dev/null
    ;;
  payload) cat "$DTMA_LOG_DIR/last-payload.txt" ;;
  metrics)
    load_config
    awk -F "$TAB" -v p="$METRIC_PREFIX" '!/^#/ && NF >= 5 { printf "%-38s %-6s %-12s %s\n", p "." $1, $2, $3, $5 }' "$DTMA_HOME/lib/metrics.tsv"
    ;;
  update) cmd_update "$@" ;;
  dashboard) cmd_dashboard ;;
  test) exec /bin/bash "$DTMA_HOME/bin/dt-mac-agent" --dry-run ;;
  send-test) cmd_send_test ;;
  config)
    need_root config
    sed -E 's/^(DT_TOKEN=["]?[^.]*\.[^.]*\.).*/\1****"/' "$DTMA_CONFIG"
    ;;
  version|--version) echo "$DTMA_VERSION" ;;
  uninstall)
    need_root uninstall
    exec /bin/bash "$DTMA_HOME/uninstall.sh" "$@"
    ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
