# dt-mac-agent configuration: /etc/dt-mac-agent/config (root:wheel, mode 600).
# This file is sourced by bash; keep the KEY="value" format.

# Dynatrace environment URL and token.
#   Platform token (dt0s16.*) needs permission: openpipeline:metrics:ingest
#   (recommended: settings:objects:write to declare metric dimensions; log ingest permission when SEND_LOGS=1)
#   Classic API token (dt0c01.*) needs scopes: metrics.ingest
#   (recommended: settings.write; logs.ingest when SEND_LOGS=1)
DT_ENV_URL="https://<your-environment-id>.apps.dynatrace.com"
DT_TOKEN="<token>"

# Optional: full endpoint overrides (e.g. Managed or ActiveGate).
# DT_INGEST_URL="https://<activegate>:9999/e/<env-id>/api/v2/metrics/ingest"
# DT_LOGS_URL="https://<activegate>:9999/e/<env-id>/api/v2/logs/ingest"

# 1 = also send the agent's own logs (agent, ingest, watchdog, install) to Dynatrace.
SEND_LOGS=0

# 1 = the watchdog checks GitHub once a day and installs new releases automatically.
AUTO_UPDATE=1

# Metric key prefix, e.g. macos.cpu.usage
METRIC_PREFIX="macos"

# Number of top process groups reported by CPU and by memory (union of both lists).
TOP_N=10

# Collection interval in seconds.
INTERVAL=60

# Offline buffer: batches are retried for up to this many minutes (max 55).
SPOOL_MAX_AGE_MIN=55
SPOOL_MAX_FILES=120

# Set to 1 to append every full metric batch to /Library/Logs/dt-mac-agent/payloads.log
# (~30 KB per minute, rotated at 10 MB). The latest batch is always in last-payload.txt.
LOG_PAYLOADS=0
